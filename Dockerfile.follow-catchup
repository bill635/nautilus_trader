# 实时Follow-Catchup套利策略 Dockerfile
FROM python:3.11-slim

ENV PYTHONUNBUFFERED=1

WORKDIR /app

# 安装依赖
RUN pip install --upgrade pip && \
    pip install ccxt pandas numpy

# 复制策略脚本
COPY realtime_follow_catchup.py ./

# 创建报告目录
RUN mkdir -p /app/reports

# 运行策略
CMD ["python", "-u", "realtime_follow_catchup.py"]
